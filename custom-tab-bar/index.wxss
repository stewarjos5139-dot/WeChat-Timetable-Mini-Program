/**custom-tab-bar/index.wxss**/

/*
 * 这是自定义组件，不是页面。page 上的 CSS 变量能否穿过组件样式隔离没实测过，
 * 所以每个引用都写「变量 + 兜底值」，两种情况下颜色都对。
 */

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-tabbar, 200);
  background: var(--card, #ffffff);
  border-top: 1rpx solid var(--line, #e8e6e1);
  transition: transform 0.24s cubic-bezier(0.32, 0.72, 0, 1);
}

/*
 * 页面弹出底部弹层时把 tabBar 滑出屏幕。
 * 自定义 tabBar 渲染在页面之上的独立层，页面里的 z-index 再大也盖不住它，
 * 所以只能让它自己让开，弹层关闭后再滑回来。
 */
.bar--hidden {
  transform: translateY(100%);
}

.bar-body {
  height: 108rpx;
  display: flex;
  align-items: center;
}

.bar-safe {
  height: env(safe-area-inset-bottom);
}

.item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.item-icon {
  width: 48rpx;
  height: 48rpx;
}

.item-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-3, #86868b);
}

.item--on .item-text {
  color: var(--accent, #2f4a8a);
  font-weight: 600;
}
