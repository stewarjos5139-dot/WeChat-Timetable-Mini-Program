<!--custom-tab-bar/index.wxml-->
<view class="bar {{hidden ? 'bar--hidden' : ''}}">
  <view class="bar-body">
    <view
      class="item {{selected === index ? 'item--on' : ''}}"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="onTap"
      aria-role="tab"
      aria-label="{{item.text}}"
      aria-selected="{{selected === index}}"
    >
      <image
        class="item-icon"
        src="/assets/icons/{{item.icon}}{{selected === index ? '-on' : ''}}.svg"
        mode="aspectFit"
      />
      <text class="item-text">{{item.text}}</text>
    </view>
  </view>
  <view class="bar-safe"></view>
</view>
