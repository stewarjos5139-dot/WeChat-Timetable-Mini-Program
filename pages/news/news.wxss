/**pages/news/news.wxss**/

.page {
  min-height: 100vh;
}

/* ============ 分类筛选 ============ */
.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  background: var(--bg);
  padding: 20rpx 0 16rpx;
}

.tabs-inner {
  display: inline-flex;
  padding: 0 32rpx;
}

.tab {
  flex: none;
  height: 60rpx;
  margin-right: 16rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  line-height: 60rpx;
  color: var(--text-2);
  transition: all 0.2s ease;
}

.tab--on {
  background: var(--brand);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 6rpx 18rpx rgba(15, 169, 126, 0.28);
}

/* ============ 资讯卡片 ============ */
.list {
  padding: 16rpx 32rpx 0;
}

.item {
  padding: 32rpx;
  margin-bottom: 24rpx;
  transition: transform 0.15s ease;
}

.item--hover {
  transform: scale(0.985);
  background: #FBFDFC;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.item-tag {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.item-time {
  font-size: 23rpx;
  color: var(--text-3);
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--text-1);
}

.item-summary {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.item-foot {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-source {
  font-size: 24rpx;
  color: var(--text-3);
}

.item-arrow {
  font-size: 34rpx;
  line-height: 1;
  color: var(--text-3);
}

/* ============ 空状态 ============ */
.empty {
  padding: 180rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.55;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-3);
}
