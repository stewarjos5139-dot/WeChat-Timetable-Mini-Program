<!--pages/news/news.wxml-->
<view class="page">

  <!-- 分类筛选 -->
  <scroll-view class="tabs" scroll-x="true" scroll-with-animation="true">
    <view class="tabs-inner">
      <view
        class="tab {{activeTab === index ? 'tab--on' : ''}}"
        wx:for="{{tabs}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onTabChange"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 资讯列表 -->
  <view class="list">
    <view
      class="item card"
      wx:for="{{list}}"
      wx:key="id"
      data-title="{{item.title}}"
      bindtap="onItemTap"
      hover-class="item--hover"
      hover-stay-time="80"
    >
      <view class="item-top">
        <view class="item-tag" style="background: {{item.tint}}; color: {{item.color}};">{{item.tag}}</view>
        <text class="item-time">{{item.time}}</text>
      </view>
      <view class="item-title">{{item.title}}</view>
      <view class="item-summary">{{item.summary}}</view>
      <view class="item-foot">
        <text class="item-source">{{item.source}}</text>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{list.length === 0}}">
    <view class="empty-icon">🍃</view>
    <view class="empty-text">这个分类下还没有资讯</view>
  </view>

  <view class="footer-tip" wx:if="{{list.length > 0}}">— 已经到底啦 —</view>
  <view class="page-bottom"></view>
</view>
