/**pages/mine/mine.wxss**/
/* 列表行 .row / .divide / .privacy 的样式在 app.wxss，这里只放本页独有的 */

.page {
  min-height: 100vh;
}

.pad {
  padding: 16rpx 32rpx 0;
}

/* ============ 用户信息 ============ */
.profile {
  padding: 32rpx;
  display: flex;
  align-items: center;
}

.avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 52rpx;
  height: 52rpx;
}

/* 有姓名时头像换成墨蓝底 + 姓名首字。
 * 白字压在 --accent(#2f4a8a) 上对比度约 8.5:1，远高于 4.5 的线 */
.avatar--text {
  background: var(--accent);
}

.avatar-initial {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  color: #fff;
}

.profile-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
}

.profile-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.profile-btn {
  flex: none;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--accent);
  color: var(--accent);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 58rpx;
  transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
}

.profile-btn--hover {
  background: var(--accent-soft);
  transform: scale(0.96);
}

/* ============ 危险操作 ============ */
.row-label--danger {
  color: var(--danger);
}

/* ============ 上课提醒 ============ */
/* 额度快用完时用墨蓝提醒一下，和「今天」标记是同一个强调色 */
.row-value--accent {
  color: var(--accent);
  font-weight: 600;
}

/* 标题区：和右侧开关垂直居中 */
.remind-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 开关：小滑块。关是发丝线灰，开是墨蓝，和「今天」标记同一个强调色。
 * 外层 hit 区用内边距 + 负外边距把可点范围撑到 84rpx 高，视觉上仍是细滑块 */
.remind-switch-hit {
  flex: none;
  margin: -16rpx -8rpx -16rpx 8rpx;
  padding: 16rpx 8rpx;
  display: flex;
  align-items: center;
}

.remind-switch-hit--hover {
  opacity: 0.75;
}

.remind-switch {
  position: relative;
  width: 88rpx;
  height: 52rpx;
  border-radius: var(--r-full);
  background: var(--line);
  transition: background-color var(--dur) var(--ease);
}

.remind-switch--on {
  background: var(--accent);
}

.remind-switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(28, 28, 30, 0.18);
  transition: transform var(--dur) var(--ease);
}

.remind-switch--on .remind-switch-knob {
  transform: translateX(36rpx);
}

/* 「获取次数」小按钮：描边胶囊，和开关按钮区分开，不抢主次 */
.remind-mini {
  flex: none;
  margin-left: 16rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--accent);
  color: var(--accent);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 50rpx;
  transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
}

.remind-mini--off {
  border-color: var(--line);
  color: var(--text-3);
}

.remind-mini--hover {
  transform: scale(0.96);
}

.remind-hint {
  margin-top: 16rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--text-3);
}

/* ---------- 底部轻提示 ----------
 * 不用 wx.showToast：它固定弹在屏幕正中，会盖住正在看的卡片。
 * 这里贴在自定义 tabBar 上方，只在需要的地方替换。 */
.page-tip {
  position: fixed;
  left: 50%;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  z-index: var(--z-sheet-top);
  max-width: 76%;
  padding: 18rpx 34rpx;
  border-radius: var(--r-full);
  background: rgba(28, 28, 30, 0.9);
  color: #fff;
  font-size: 26rpx;
  line-height: 1.45;
  text-align: center;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, 16rpx);
  transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
}

.page-tip--show {
  opacity: 1;
  transform: translate(-50%, 0);
}
