/**pages/mine/mine.wxss**/
/* 列表行 .row / .divide / .privacy 的样式在 app.wxss，这里只放本页独有的 */

.page {
  min-height: 100vh;
}

.pad {
  padding: 16rpx 32rpx 0;
}

/* ============ 用户信息 ============ */
.profile {
  padding: 32rpx;
  display: flex;
  align-items: center;
}

.avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 52rpx;
  height: 52rpx;
}

.profile-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
}

.profile-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.profile-btn {
  flex: none;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--accent);
  color: var(--accent);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 58rpx;
  transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
}

.profile-btn--hover {
  background: var(--accent-soft);
  transform: scale(0.96);
}

/* ============ 危险操作 ============ */
.row-label--danger {
  color: var(--danger);
}
