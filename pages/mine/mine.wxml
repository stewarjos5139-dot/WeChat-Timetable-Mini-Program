<!--pages/mine/mine.wxml-->
<view class="page">
  <view class="pad">

    <!-- 用户信息 -->
    <view class="card profile">
      <view class="avatar {{initial ? 'avatar--text' : ''}}">
        <text class="avatar-initial" wx:if="{{initial}}">{{initial}}</text>
        <image wx:else class="avatar-img" src="/assets/icons/tab-mine.svg" mode="aspectFit" />
      </view>
      <view class="profile-body">
        <text class="profile-name">{{loggedIn ? name : '未登录'}}</text>
        <text class="profile-sub">{{subText}}</text>
      </view>
      <view
        class="profile-btn"
        bindtap="onImport"
        hover-class="profile-btn--hover"
        hover-stay-time="60"
        aria-role="button"
      >{{loggedIn ? '重新导入' : '导入课表'}}</view>
    </view>

    <!-- 课表 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">课表</text>
      </view>

      <view class="card">
        <view class="row" bindtap="onImport" hover-class="row--hover" hover-stay-time="60" aria-role="button">
          <image class="row-icon" src="/assets/icons/import.svg" mode="aspectFit" />
          <text class="row-label">导入课表</text>
          <text class="row-value">{{hasSchedule ? termText : '未导入'}}</text>
          <image class="row-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" />
        </view>

        <view class="divide"></view>

        <!-- 课表字体大小：一条刻度线 + 可拖动的圆点，松手吸附到最近一档 -->
        <view class="fontrow">
          <view class="fontrow-head">
            <text class="fontrow-label">课表区域字体大小</text>
            <text class="fontrow-value">{{fontLabels[fontIndex]}}</text>
          </view>

          <view
            class="fs-area"
            bindtouchstart="onFontTouchStart"
            catchtouchmove="onFontTouchMove"
            bindtouchend="onFontTouchEnd"
            bindtouchcancel="onFontTouchEnd"
            aria-role="slider"
            aria-label="课表区域字体大小"
          >
            <view class="fs-track">
              <view class="fs-fill" style="width: {{fontFillWidth}}px;"></view>
              <view
                wx:for="{{fontLabels}}"
                wx:key="*this"
                class="fs-tick {{index <= fontIndex ? 'fs-tick--on' : ''}}"
                style="left: {{index * 25}}%;"
              ></view>
            </view>
            <view
              class="fs-knob {{fontDragging ? 'fs-knob--dragging' : ''}}"
              style="left: {{fontKnobX}}px;"
            ></view>
          </view>

          <view class="fs-labels">
            <text
              wx:for="{{fontLabels}}"
              wx:key="*this"
              class="fs-label {{index === fontIndex ? 'fs-label--on' : ''}}"
              style="left: {{index * 25}}%;"
            >{{item}}</text>
          </view>
        </view>

        <view class="divide"></view>

        <view class="row" bindtap="onClearSchedule" hover-class="row--hover" hover-stay-time="60" aria-role="button">
          <image class="row-icon" src="/assets/icons/trash.svg" mode="aspectFit" />
          <text class="row-label row-label--danger">清除课表数据</text>
          <image class="row-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" />
        </view>
      </view>
    </view>

    <!-- 提醒 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">提醒</text>
      </view>

      <view class="card">
        <!-- 开关 -->
        <view class="row">
          <image class="row-icon" src="/assets/icons/bell.svg" mode="aspectFit" />
          <view class="remind-body">
            <text class="row-label">上课提醒</text>
          </view>
          <view
            class="remind-switch-hit"
            bindtap="onRemindToggle"
            hover-class="remind-switch-hit--hover"
            hover-stay-time="60"
            aria-role="switch"
            aria-checked="{{remindOn}}"
            aria-label="上课提醒"
          >
            <view class="remind-switch {{remindOn ? 'remind-switch--on' : ''}}">
              <view class="remind-switch-knob"></view>
            </view>
          </view>
        </view>

        <view class="divide"></view>

        <!-- 课前提醒时间：点整行打开选择器 -->
        <picker mode="selector" range="{{leadLabels}}" value="{{leadIndex}}" bindchange="onLeadChange">
          <view class="row" hover-class="row--hover" hover-stay-time="60" aria-role="button">
            <image class="row-icon" src="/assets/icons/clock.svg" mode="aspectFit" />
            <text class="row-label">课前提醒</text>
            <text class="row-value num">{{remindLead}} 分钟前</text>
            <image class="row-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" />
          </view>
        </picker>

        <view class="divide"></view>

        <!-- 提醒次数：剩余条数 + 获取按钮 -->
        <view class="row">
          <image class="row-icon" src="/assets/icons/ticket.svg" mode="aspectFit" />
          <text class="row-label">剩余提醒次数</text>
          <text class="row-value {{remindOn && remindQuota <= 2 ? 'row-value--accent' : ''}}">{{remindQuotaText}}</text>
          <view
            class="remind-mini {{remindOn ? '' : 'remind-mini--off'}}"
            bindtap="onGetQuota"
            hover-class="remind-mini--hover"
            hover-stay-time="60"
            aria-role="button"
          >获取次数</view>
        </view>
      </view>
      <text class="remind-hint">开启后将通过微信服务通知提醒上课</text>
      <text class="remind-hint">点击获取次数可获取一次提醒次数,次数耗尽后将自动关闭上课提醒功能</text>
      
    </view>

    <!-- 其他 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">其他</text>
      </view>

      <view class="card">
        
        <view class="row" bindtap="onAuthorNote" hover-class="row--hover" hover-stay-time="60" aria-role="button">
          <image class="row-icon" src="/assets/icons/book.svg" mode="aspectFit" />
          <text class="row-label">作者的话</text>
          <image class="row-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" />
        </view>

        <view class="divide"></view>

        <view class="row" bindtap="onAbout" hover-class="row--hover" hover-stay-time="60" aria-role="button">
          <image class="row-icon" src="/assets/icons/info.svg" mode="aspectFit" />
          <text class="row-label">关于 星瞢课表</text>
          <text class="row-value num">v{{version}}</text>
          <image class="row-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" />
        </view>
        <view class="divide"></view>
        <!-- 公众号入口：没配原始 ID 时整行不出现 -->
      <block wx:if="{{officialAccount.username}}">
          <view
            class="row"
            bindtap="onOpenOfficialAccount"
            hover-class="row--hover"
            hover-stay-time="60"
            aria-role="button"
          >
            <image class="row-icon" src="/assets/icons/wechat.svg" mode="aspectFit" />
            <text class="row-label">获取更新 关注官方公众号</text>
            <text class="row-value" wx:if="{{officialAccount.name}}">{{officialAccount.name}}</text>
            <image class="row-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" />
          </view>
          <view class="divide"></view>
        </block>

        <!-- 分享给同学：open-type="share" 走 onShareAppMessage -->
        <button
          class="row row-btn"
          open-type="share"
          hover-class="row--hover"
          hover-stay-time="60"
          aria-role="button"
        >
          <image class="row-icon" src="/assets/icons/share.svg" mode="aspectFit" />
          <text class="row-label">分享给同学</text>
          <image class="row-arrow" src="/assets/icons/chevron.svg" mode="aspectFit" />
        </button>

      </view>
    </view>

    <view class="privacy">
      <view class="privacy-head">
        <image class="privacy-icon" src="/assets/icons/lock.svg" mode="aspectFit" />
        <text class="privacy-title">账号安全</text>
      </view>
      <text class="privacy-item">· 密码不会保存在本机，本机只记住学号</text>
      <text class="privacy-item">· 导入时密码会经由中间层服务转发给学校教务系统</text>
    </view>

    <view class="footer-tip">星瞢课表</view>
  </view>

  <view class="tabbar-space"></view>

  <!-- 轻提示：贴屏幕下方，不遮挡正在操作的内容 -->
  <view class="page-tip {{tipShow ? 'page-tip--show' : ''}}">{{tipText}}</view>
</view>
