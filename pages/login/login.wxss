/**pages/login/login.wxss**/

/* 登录页不是 tab 页，底部不需要 tabBar 留白，给普通边距即可 */
.page {
  min-height: 100vh;
  padding: 0 32rpx 64rpx;
}

/* ============ 说明头 ============ */
.intro {
  padding: 24rpx 8rpx 8rpx;
  display: flex;
  flex-direction: column;
}

.intro-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--text-1);
}

.intro-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--text-2);
}

/* ============ 表单 ============ */
.group-label {
  margin: 44rpx 8rpx 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
  letter-spacing: 2rpx;
}

.field {
  min-height: 104rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  transition: background-color var(--dur) var(--ease);
}

.field--hover {
  background: var(--hover-bg);
}

.field-label {
  flex: none;
  width: 150rpx;
  font-size: 29rpx;
  color: var(--text-1);
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  font-size: 29rpx;
  color: var(--text-1);
}

.ph {
  color: var(--text-3);
}

.field-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-2);
}

.field-arrow {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

/* 表单行没有图标，分割线与标签左边缘对齐 */
.card .divide {
  margin-left: 28rpx;
}

.form-hint {
  margin-top: 16rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--text-3);
}

/* ============ 提交按钮 ============ */
.submit {
  margin-top: 48rpx;
}

/* 后端未就绪时压暗，但仍然可点 —— 点了会说明缺什么 */
.submit--off {
  background: #a3a9b8;
}

/* ============ 后端未配置提示 ============ */
.notice {
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--r-md);
  background: var(--warn-bg);
  border: 1rpx solid var(--warn-line);
}

.notice-head {
  display: flex;
  align-items: center;
}

.notice-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--warn-text);
}

.notice-text {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: var(--warn-text);
}
