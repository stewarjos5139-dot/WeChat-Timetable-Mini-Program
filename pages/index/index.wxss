/**pages/index/index.wxss**/

.page {
  min-height: 100vh;
}

/* ============ 顶部渐变头 ============ */
.hero {
  position: relative;
  padding: 0 32rpx 132rpx;
  background: linear-gradient(158deg, #19C493 0%, #0FA97E 48%, #098A66 100%);
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}

/* 两颗装饰光斑，让纯色渐变有层次 */
.hero::before {
  content: '';
  position: absolute;
  top: -180rpx;
  right: -140rpx;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
}

.hero::after {
  content: '';
  position: absolute;
  bottom: -120rpx;
  left: -110rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

/* ---- 导航栏 ---- */
.navbar {
  position: relative;
  z-index: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 52rpx;
  height: 52rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-name {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.bell {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-icon {
  font-size: 32rpx;
}

.bell-dot {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FFD66B;
  border: 3rpx solid #12A87D;
}

/* ---- 问候语 ---- */
.greet {
  position: relative;
  z-index: 1;
  padding: 44rpx 0 40rpx;
}

.greet-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.greet-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* ---- 搜索框 ---- */
.search {
  position: relative;
  z-index: 1;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(6, 90, 68, 0.16);
}

.search-icon {
  margin-right: 14rpx;
  font-size: 28rpx;
  opacity: 0.5;
}

.search-ph {
  font-size: 27rpx;
  color: var(--text-3);
}

/* ============ 快捷入口（上浮卡片） ============ */
.quick {
  position: relative;
  z-index: 2;
  margin: -84rpx 32rpx 0;
  padding: 40rpx 12rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  box-shadow: var(--shadow-float);
}

.quick-item {
  width: 25%;
  padding: 12rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s ease;
}

.quick-item--hover {
  transform: scale(0.94);
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 14rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.quick-label {
  font-size: 24rpx;
  color: var(--text-2);
}

/* ============ 区块横向留白 ============ */
.section {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

/* 「全部」右侧的日期不要箭头 */
.today-date::after {
  content: '';
}

/* ============ 校园资讯 ============ */
.news-card {
  padding: 6rpx 0;
  overflow: hidden;
}

.news-item {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: flex-start;
}

.row--hover {
  background: #F7FAF9;
}

.news-tag {
  flex: none;
  height: 40rpx;
  margin: 4rpx 22rpx 0 0;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.news-body {
  flex: 1;
  min-width: 0;
}

.news-title {
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.45;
  color: var(--text-1);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

/* ============ 今日课表 ============ */
.course-card {
  padding: 10rpx 0 16rpx;
}

.course {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: stretch;
}

.course--hover {
  background: #F7FAF9;
}

.course-time {
  flex: none;
  width: 96rpx;
  padding-top: 4rpx;
  display: flex;
  flex-direction: column;
}

.course-start {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.course-end {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.course-rail {
  flex: none;
  width: 8rpx;
  margin: 4rpx 26rpx 4rpx 0;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #19C493, #0FA97E);
}

.course-body {
  flex: 1;
  min-width: 0;
}

.course-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-1);
}

.course-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-3);
}
