<!--pages/library/library.wxml-->
<view class="page">
  <view class="pad">

    <!-- 开馆状态 -->
    <view class="hero">
      <view class="hero-top">
        <text class="hero-title">图书馆</text>
        <view class="hero-status {{openNow ? 'hero-status--on' : 'hero-status--off'}}">
          <view class="hero-dot"></view>
          <text>{{openNow ? '开放中' : '已闭馆'}}</text>
        </view>
      </view>

      <text class="hero-hours">今日开放 {{todayHours}}</text>
      <text class="hero-note">{{statusNote}}</text>
    </view>

    <!-- 规划中的功能 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">即将上线</text>
      </view>

      <view class="card">
        <block wx:for="{{features}}" wx:key="name">
          <view class="divide" wx:if="{{index > 0}}"></view>
          <view
            class="feat"
            data-name="{{item.name}}"
            bindtap="onFeatureTap"
            hover-class="feat--hover"
            hover-stay-time="60"
          >
            <view class="feat-icon" style="background: {{item.tint}};">{{item.icon}}</view>
            <view class="feat-body">
              <text class="feat-name">{{item.name}}</text>
              <text class="feat-desc">{{item.desc}}</text>
            </view>
            <text class="feat-tag">规划中</text>
          </view>
        </block>
      </view>
    </view>

    <view class="footer-tip">— 数据接入后开放 —</view>
  </view>

  <view class="tabbar-space"></view>
</view>
