<!--pages/library/library.wxml-->
<view class="page">
  <view class="pad">

    <!-- 开馆状态 -->
    <view class="card status">
      <view class="status-top">
        <text class="status-label">图书馆 · 今日</text>
        <text class="status-hours num">{{todayHours}}</text>
      </view>

      <view class="status-main">
        <view class="status-dot {{openNow ? 'status-dot--on' : 'status-dot--off'}}"></view>
        <text class="status-text">{{openNow ? '开放中' : '已闭馆'}}</text>
      </view>

      <text class="status-note">{{statusNote}}</text>
    </view>

    <!-- 规划中的功能 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">即将上线</text>
      </view>

      <view class="card">
        <block wx:for="{{features}}" wx:key="name">
          <view class="divide feat-divide" wx:if="{{index > 0}}"></view>
          <view
            class="row feat"
            data-name="{{item.name}}"
            bindtap="onFeatureTap"
            hover-class="row--hover"
            hover-stay-time="60"
            aria-role="button"
          >
            <view class="feat-icon">
              <image class="feat-icon-img" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit" />
            </view>
            <view class="feat-body">
              <text class="feat-name">{{item.name}}</text>
              <text class="feat-desc">{{item.desc}}</text>
            </view>
            <text class="feat-tag">规划中</text>
          </view>
        </block>
      </view>
    </view>

    <view class="footer-tip">数据接入后开放</view>
  </view>

  <view class="tabbar-space"></view>
</view>
