/**pages/library/library.wxss**/

.page {
  min-height: 100vh;
}

.pad {
  padding: 24rpx 32rpx 0;
}

/* ============ 开馆状态卡 ============ */
.hero {
  position: relative;
  padding: 40rpx 36rpx 44rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(150deg, #19C493 0%, #0FA97E 55%, #0B8E6A 100%);
  box-shadow: 0 12rpx 32rpx rgba(15, 169, 126, 0.24);
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.hero-status {
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #fff;
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #B9F5E1;
}

.hero-status--off .hero-dot {
  background: #FFD2D2;
}

.hero-hours {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
}

.hero-note {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ============ 功能列表 ============ */
.feat {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
}

.feat--hover {
  background: #F7FAF9;
}

.feat-icon {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.feat-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.feat-name {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--text-1);
}

.feat-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.feat-tag {
  flex: none;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #F2F5F6;
  color: var(--text-3);
  font-size: 20rpx;
  line-height: 36rpx;
}

/* 分割线与图标右侧对齐 */
.divide {
  margin-left: 132rpx;
}
