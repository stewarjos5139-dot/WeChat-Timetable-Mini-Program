/**pages/library/library.wxss**/

.page {
  min-height: 100vh;
}

.pad {
  padding: 16rpx 32rpx 0;
}

/* ============ 开馆状态卡 ============ */
.status {
  padding: 32rpx 36rpx 36rpx;
}

.status-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-label {
  font-size: 24rpx;
  color: var(--text-2);
}

.status-hours {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: var(--fill);
  font-size: 22rpx;
  line-height: 40rpx;
  color: var(--text-2);
}

.status-main {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
}

/* 开馆/闭馆是语义指示色，不用强调色 */
.status-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 16rpx;
  border-radius: 50%;
}

.status-dot--on {
  background: var(--ok);
}

.status-dot--off {
  background: var(--text-3);
}

.status-text {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--text-1);
}

.status-note {
  display: block;
  margin-top: 10rpx;
  padding-left: 34rpx; /* 与上方文字左对齐（圆点 18 + 间距 16） */
  font-size: 25rpx;
  color: var(--text-2);
}

/* ============ 功能列表 ============ */
.feat {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.feat-icon {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  margin-right: 24rpx;
  border-radius: var(--r-md);
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
}

.feat-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.feat-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.feat-name {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--text-1);
}

.feat-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.feat-tag {
  flex: none;
  height: 36rpx;
  margin-left: 16rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  color: var(--text-3);
  font-size: 20rpx;
  line-height: 34rpx;
}

/* 分割线与文字左边缘对齐（内边距 28 + 图标 72 + 间距 24） */
.feat-divide {
  margin-left: 124rpx;
}
